NODE_ENV=production
PORT=3000
DATA_DIR=/data
# Optional: enforce an exact public site origin for POST/PATCH/DELETE protection.
# PUBLIC_ORIGIN=https://animations.yourdomain.com

# AI maker: select a Responses-compatible model supporting structured outputs.
OPENAI_API_KEY=
ANIMATION_AI_MODEL=

# Server-only bootstrap, disabled by default. Never embed the setup key in frontend files.
# Enable only during initial account provisioning; disable and remove OWNER_SETUP_KEY afterward.
OWNER_SETUP_ENABLED=false
